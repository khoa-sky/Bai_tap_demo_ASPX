<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Bai_tap_demo_ASPX.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cửa hàng mini DEMO</title>
    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="Default.aspx">
                    <img src="images/logo.jpg" height="50" alt="Mini Store" />
                    Mini Store
                </a>
                <div class="d-flex gap-2">
                    <a href="DemoCookie.aspx" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold">Cookie</a>
                    <a href="DemoSession_Login.aspx" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">Session</a>
                    <a href="DemoViewState.aspx" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">ViewState</a>
                    <a href="Reset.aspx" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">Reset</a>
                </div>
            </div>
        </nav>
        <!--Thanh X Quang-->
        <div style="background-color: #1e293b; color: #f8fafc; font-family: Consolas, monospace; font-size: 13px;" class="py-2 border-bottom border-secondary">
            <div class="container d-flex align-items-center gap-3 flex-nowrap overflow-hidden">
                <span class="fw-bold text-uppercase text-white text-nowrap">X-QUANG:</span>
                <span class="text-nowrap">SessionID:
                    <asp:Label ID="lblXRaySession" runat="server" ForeColor="#38bdf8" /></span>
                <span>|</span>
                <span class="text-truncate">Cookies:
                    <asp:Label ID="lblXRayCookies" runat="server" ForeColor="#fb923c" /></span>
                <span>|</span>
                <span class="text-nowrap">ViewState: <span id="xray-viewstate" style="color: #4ade80;">0 chars</span></span>
            </div>
        </div>
        <!--Nội dung trang con-->
        <div class="container my-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </form>
</body>
<script>
(function () {
    var vs = document.getElementById('__VIEWSTATE');
    var val = vs ? (vs.getAttribute('value') || '') : '';
    var len = val.length;
    var el = document.getElementById('xray-viewstate');
    if (el) {
        el.innerText = len + ' chars (~' + (len / 1024).toFixed(2) + ' KB)';
    }
})();
</script>
</html>
